{
  "name": "see-you-at-the-hive",
  "version": "0.9.5-rc.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:web-game": "./scripts/build_web_game.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/build-provenance.test.mjs tests/artifact-manifest.test.mjs tests/audio-blind-review.test.mjs tests/music-generation.test.mjs tests/commercial-audio-generation.test.mjs tests/commercial-outward-copy.test.mjs tests/commercial-script-class-cache.test.mjs tests/journey-campaign-catalog.test.mjs tests/autumn-full-loop-ab.test.mjs tests/playtest-evidence.test.mjs tests/playtest-launch.test.mjs",
    "test:godot": "./scripts/test_godot.sh",
    "verify:godot-export": "./scripts/verify_godot_export_contents.sh",
    "audio:review": "node scripts/prepare_audio_blind_review.mjs",
    "audio:autumn-final-ab": "node scripts/prepare_autumn_full_loop_ab.mjs",
    "audio:commercial": "node scripts/generate_commercial_audio.mjs",
    "playtest:prepare": "node scripts/prepare_playtest_evidence.mjs",
    "playtest:launch": "node scripts/launch_playtest.mjs",
    "art:build": "node scripts/package_art_review.mjs --build",
    "art:package": "node scripts/package_art_review.mjs",
    "art:package:mac": "node scripts/package_macos_art_review.mjs",
    "test:art-review": "node --test tests/art-review.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
