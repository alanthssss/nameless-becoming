      "intro": "暖蜡离开暖区后会慢慢降温。接暖，也接班；雪团谁都别接。",
      "dialogue": "换班蜂：你接暖，我接班，雪团谁都别接。",
      "world_trace": "换班蜂流开始沿连续暖路运行。",
      "objectives": [
        {"type": "carry", "label": "把暖蜡送到换班点", "goal": 2},
        {"type": "warmth", "label": "接成连续暖路", "goal": 4}
      ]
    },
    {
      "id": "winter_daxue", "order": 20, "season_id": "winter", "kind": "standard",
      "scene_key": "winter_term_field", "scenario_id": "rope_through_snow", "reward_honey": 2,
      "target_minutes": 11, "time_limit_seconds": 780, "energy_drain": 0.96, "hazard": "deep_snow", "map_variant": 2,
      "intro": "拖行藤绳不能穿过雪堆尖角。先理绳路，再把备用木钉送到墙架。",
