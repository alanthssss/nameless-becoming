        {"id": "finish_flowers", "label": "风转时逐花收尾", "instruction": "趁风向转换的间隙，按自己的安排逐花完成收蜜或留种。", "goal": 1},
        {"id": "send_light_seeds", "label": "把轻种送过霜线", "instruction": "霜线转薄时，把三份轻种送到背风花地。", "goal": 1}
      ]
    },
    {
