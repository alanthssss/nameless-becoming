; Engine configuration file.
; Godot 4.6 project for Hivebound Seasons.

config_version=5

[application]

config/name="归巢之前"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]

harvest={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32,"unicode":32)]
}
dash={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
sting={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":74,"unicode":106)]
}

[gui]

theme/default_font_multichannel_signed_distance_field=true
