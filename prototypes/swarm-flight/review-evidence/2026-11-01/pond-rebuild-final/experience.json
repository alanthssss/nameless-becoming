        "options": [
          {
            "approach": "exposed_continuous_flight",
            "action": "穿过露天空隙，减少主动停靠，遇茎顶再调整高度。",
            "expected_consequence": "更快向前，但更长时间暴露于雨中并消耗体力。",
            "visual_basis": "18-stage04-paused-entry.png 显示雨中停走与0/5叶下；19-stage04-visible-start.png 可见通往叶棚的露天空隙。"
          },
          {
            "approach": "shelter_then_cross",
            "action": "先进入叶棚停靠，再从恢复后的状态跨下一段空隙。",
            "expected_consequence": "可恢复体力、获得安全与检查点信息，但需要停靠和调整高度。",
            "visual_basis": "18-stage04-paused-entry.png 提示从叶下看雨；19-stage04-visible-start.png 可见带向下标记的宽叶棚；08-stage03-leaf.png 是本次旅程此前亲自观察的叶下恢复。"
          }
